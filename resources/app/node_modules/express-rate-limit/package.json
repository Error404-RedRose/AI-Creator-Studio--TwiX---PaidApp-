{
  "name": "express-rate-limit",
  "version": "8.7.2",
  "description": "Basic IP rate-limiting middleware for Express. Use to limit repeated requests to public APIs and/or endpoints such as password reset.",
  "author": {
    "name": "Nathan Friedly",
    "url": "http://nfriedly.com/"
  },
  "license": "MIT",
  "homepage": "https://github.com/express-rate-limit/express-rate-limit",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/express-rate-limit/express-rate-limit.git"
  },
  "funding": "https://github.com/sponsors/express-rate-limit",
  "type": "module",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "files": [
    "dist/",
    "tsconfig.json"
  ],
  "engines": {
    "node": ">= 16"
  },
  "dependencies": {
    "debug": "^4.4.3",
    "ip-address": "^10.2.0"
  },
  "peerDependencies": {
    "express": ">= 4.11"
  },
  "devDependencies": {
    "@asyncapi/specs": "6.11.1",
    "@biomejs/biome": "2.4.6",
    "@express-rate-limit/prettier": "1.1.1",
    "@express-rate-limit/tsconfig": "1.0.5",
    "@jest/globals": "30.5.2",
    "@types/debug": "4.1.13",
    "@types/express": "5.0.6",
    "@types/jest": "30.0.0",
    "@types/node": "26.6.4",
    "@types/supertest": "7.2.1",
    "del-cli": "7.0.0",
    "dts-bundle-generator": "8.1.2",
    "esbuild": "0.28.2",
    "express": "5.2.1",
    "husky": "9.1.7",
    "jest": "30.5.2",
    "lint-staged": "17.6.0",
    "mintlify": "4.2.988",
    "npm-run-all": "4.1.5",
    "prettier": "3.9.9",
    "ratelimit-header-parser": "0.2.1",
    "supertest": "7.3.1",
    "ts-jest": "29.4.14",
    "ts-node": "10.9.2",
    "typescript": "5.9.3"
  },
  "prettier": "@express-rate-limit/prettier",
  "lint-staged": {
    "*.{js,ts,json}": "biome check --write",
    "*.md": "prettier --write"
  }
}